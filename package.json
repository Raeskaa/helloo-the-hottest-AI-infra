{
  "name": "helloo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "deploy": "turbo deploy",
    "db:generate": "pnpm --filter @helloo/auth db:generate",
    "db:migrate": "pnpm --filter @helloo/db db:migrate:gen && pnpm --filter @helloo/db db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
