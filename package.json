{
  "name": "helloo",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "deploy": "turbo deploy",
    "db:generate": "pnpm --filter @helloo/auth db:generate",
    "db:migrate": "pnpm --filter @helloo/db db:migrate:gen && pnpm --filter @helloo/db db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "better-call": "1.4.0",
      "@better-fetch/fetch": "1.3.1"
    }
  }
}
