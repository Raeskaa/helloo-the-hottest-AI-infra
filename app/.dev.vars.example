# Copy this to `.dev.vars` (which is gitignored) and fill in real values.
# In production, set these with:  wrangler secret put <NAME>

# --- Core (required) ---
BETTER_AUTH_URL=http://localhost:8787
# Generate a strong secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Neon Postgres connection string (https://neon.tech → create project → copy the pooled connection string)
DATABASE_URL=

# --- Email (for OTP + magic-link). Optional in dev: if RESEND_API_KEY is blank,
#     codes/links are printed to the console so you can still sign in locally. ---
RESEND_API_KEY=
EMAIL_FROM=helloo <onboarding@resend.dev>

# --- Social login (all optional — leave a pair blank to disable that provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
