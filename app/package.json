{
  "name": "helloo-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "better-auth generate --config ./better-auth.config.ts --output ./src/db/schema.ts -y",
    "db:migrate:gen": "drizzle-kit generate --dialect postgresql",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "better-auth": "^1.3.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.3.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
