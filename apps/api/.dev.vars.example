# Copy to `apps/api/.dev.vars` (gitignored) and fill in real values.
# Prod: set each with `wrangler secret put <NAME>` (run inside apps/api).

# --- Core (required) ---
BETTER_AUTH_URL=http://localhost:8787
# Generate:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Neon Postgres pooled connection string (neon.tech) — OWNER role (auth + migrations)
DATABASE_URL=
# Non-owner runtime role for the membrane (RLS binds). Create with:
#   ADMIN_DATABASE_URL=<owner direct url> APP_DB_PASSWORD=$(openssl rand -hex 24) \
#     node packages/db/scripts/create-app-role.mjs
# then: postgresql://helloo_app:<APP_DB_PASSWORD>@<pooled-host>/<db>?sslmode=require
APP_DATABASE_URL=

# --- Email (OTP + magic link). Optional in dev: if blank, codes print to console. ---
RESEND_API_KEY=
EMAIL_FROM=helloo <onboarding@resend.dev>

# --- Memory fact-pipeline LLM (Google AI Studio key). Required for /api/memory/ingest. ---
GEMINI_API_KEY=

# --- Integrations (Composio) — connect + act on real accounts (Gmail, Calendar, …). ---
COMPOSIO_API_KEY=

# --- Social login (optional — leave a pair blank to disable that provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
