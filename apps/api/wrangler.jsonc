{
  // helloo API — Cloudflare Worker (Hono + Better Auth).
  // Secrets are NOT stored here. Local: apps/api/.dev.vars (gitignored).
  // Prod: `wrangler secret put <NAME>`.
  "name": "helloo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Warm-up cron: ping Neon every 3 min so its free-tier compute doesn't suspend between
  // messages — the cold-start was making the Telegram bot drop replies. (Tradeoff: keeping it
  // warm uses free compute-hours; if the monthly allowance runs out, widen the interval or move
  // to always-on compute.)
  "triggers": { "crons": ["*/3 * * * *"] },
  // One durable agent per user (the runtime); SQLite-backed DO storage.
  "durable_objects": {
    "bindings": [{ "name": "HELLO_AGENT", "class_name": "HelloAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HelloAgent"] }]
}
